// Скопіюйте у Secrets.xcconfig поруч (він у .gitignore) і вставте iOS client ID з Google Cloud Console.
// Формат: <цифри>-<рядок>.apps.googleusercontent.com, без схеми та лапок.
GOOGLE_IOS_CLIENT_ID=

// Прод-адреса бекенда для Release-збірки. "//" у xcconfig починає коментар, тому пишемо "/$()/":
// API_PROD_BASE_URL=https:/$()/api.example.com
API_PROD_BASE_URL=
