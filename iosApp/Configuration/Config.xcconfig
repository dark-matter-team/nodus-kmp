TEAM_ID=

PRODUCT_NAME=Nodus
PRODUCT_BUNDLE_IDENTIFIER=com.darkmatter.nodus.Nodus$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// iOS OAuth client ID Google (тип "iOS"). Справжнє значення лише в Secrets.xcconfig (не в git),
// приклад: Secrets.example.xcconfig. Без нього збірка проходить, а вхід через Google не налаштований.
GOOGLE_IOS_CLIENT_ID=

// Адреса бекенда, за замовчуванням локальний; змінюється в Secrets.xcconfig (API_BASE_URL).
// "//" у xcconfig починає коментар, тому в адресі пишемо "/$()/": Xcode підставить порожній рядок.
API_BASE_URL=http:/$()/localhost:5033
#include? "Secrets.xcconfig"
